{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentremote.dev/schemas/release-manifest-v4.json",
  "title": "Agent Remote release composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "distribution_version", "components"],
  "properties": {
    "schema_version": { "const": 4 },
    "distribution_version": { "$ref": "#/$defs/semver" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent-remote-server",
        "agent-remote-node",
        "agent-remote-cli",
        "agent-remote-admin-web",
        "agent-remote-device",
        "agent-remote-ego-browser"
      ],
      "properties": {
        "agent-remote-server": { "$ref": "#/$defs/component" },
        "agent-remote-node": { "$ref": "#/$defs/component" },
        "agent-remote-cli": { "$ref": "#/$defs/component" },
        "agent-remote-admin-web": { "$ref": "#/$defs/component" },
        "agent-remote-device": { "$ref": "#/$defs/component" },
        "agent-remote-ego-browser": { "$ref": "#/$defs/egoBrowserComponent" }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-.+][0-9A-Za-z.-]+)?$"
    },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "release_workflow", "version", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^Agent-Remote/agent-remote-[A-Za-z0-9-]+$" },
        "release_workflow": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.ya?ml$" },
        "version": { "$ref": "#/$defs/semver" },
        "commit": { "$ref": "#/$defs/gitSha" }
      }
    },
    "egoBrowserComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "release_workflow",
        "version",
        "commit",
        "profile_id",
        "profile_version",
        "bridge_version",
        "bridge_protocol_version",
        "ego_lite_runtime_version",
        "wrapper_version",
        "artifact_url",
        "artifact_sha256",
        "bridge_manifest_sha256",
        "ego_lite_installer_url",
        "ego_lite_installer_commit",
        "ego_lite_installer_sha256",
        "valid_platforms",
        "allowed_server_origins",
        "admission_policy_ref",
        "issued_at",
        "replaces_profile",
        "release_published",
        "profile",
        "signing_type",
        "signer_certificate_sha256",
        "production_ready",
        "readiness_blockers",
        "apple_notarized",
        "public_distribution",
        "hardened_runtime",
        "nested_signatures_verified",
        "outbound_policy",
        "credential_profile",
        "learning_bundle_digest",
        "learning_bundle_signing_key_id",
        "skill_version",
        "skill_commit",
        "skill_tree_sha256",
        "local_ego_browser_runtime_version",
        "protocol_version"
      ],
      "properties": {
        "repository": { "const": "Agent-Remote/agent-remote-ego-browser" },
        "release_workflow": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.ya?ml$" },
        "version": { "$ref": "#/$defs/semver" },
        "commit": { "$ref": "#/$defs/gitSha" },
        "profile_id": { "const": "community-local-trust" },
        "profile_version": { "$ref": "#/$defs/semver" },
        "bridge_version": { "$ref": "#/$defs/semver" },
        "bridge_protocol_version": { "const": "ego-browser-bridge-v1" },
        "ego_lite_runtime_version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){3}$" },
        "wrapper_version": { "$ref": "#/$defs/semver" },
        "artifact_url": {
          "type": "string",
          "pattern": "^https://github\\.com/Agent-Remote/agent-remote-ego-browser/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-.+][0-9A-Za-z.-]+)?/agent-remote-ego-browser-macos-universal-[0-9]+\\.[0-9]+\\.[0-9]+(?:[-.+][0-9A-Za-z.-]+)?\\.tar\\.gz$"
        },
        "artifact_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "bridge_manifest_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "ego_lite_installer_url": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/citrolabs/ego-lite/[0-9a-f]{40}/skills/ego-browser/scripts/install\\.sh$"
        },
        "ego_lite_installer_commit": { "$ref": "#/$defs/gitSha" },
        "ego_lite_installer_sha256": { "$ref": "#/$defs/sha256" },
        "valid_platforms": {
          "type": "array",
          "const": ["macos"]
        },
        "allowed_server_origins": {
          "type": "array",
          "const": ["$active_login_origin"]
        },
        "admission_policy_ref": { "const": "server-policy:ego-browser-v1" },
        "issued_at": {
          "oneOf": [
            { "type": "string", "format": "date-time", "pattern": "Z$" },
            { "type": "null" }
          ]
        },
        "replaces_profile": {
          "type": "string",
          "pattern": "^community-local-trust@[0-9]+\\.[0-9]+\\.[0-9]+(?:[-.+][0-9A-Za-z.-]+)?$"
        },
        "release_published": { "type": "boolean" },
        "profile": { "const": "community-local-trust" },
        "signing_type": { "const": "project-self-signed" },
        "signer_certificate_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "production_ready": { "type": "boolean" },
        "readiness_blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "apple_notarized": { "const": false },
        "public_distribution": { "const": false },
        "hardened_runtime": { "const": true },
        "nested_signatures_verified": { "type": "boolean" },
        "outbound_policy": { "const": "application-enforced" },
        "credential_profile": { "const": "community_file" },
        "learning_bundle_digest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "learning_bundle_signing_key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "skill_version": { "const": "1.2.3" },
        "skill_commit": { "const": "36053d07001a910cb806a15d42d00fdea1cdea3d" },
        "skill_tree_sha256": { "const": "262110a09678fd3e0bbb382400588dacb98b24659b3b4a57903703b65d133c7c" },
        "local_ego_browser_runtime_version": { "const": "0.4.7.4" },
        "protocol_version": { "const": "ego-browser-bridge-v1" }
      }
    }
  }
}
